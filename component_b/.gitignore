# Virtual environment (each person creates their own)
.venv/
# Raw/processed data can be large and is re-downloadable -> keep out of git
data/raw/*
data/processed/*
!data/**/.gitkeep
# Python / Jupyter clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
# Secrets (NVD API key lives in .env) -> never commit
.env
.env.*
